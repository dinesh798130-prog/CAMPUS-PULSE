{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*", "prisma/seed.ts", "scripts/**/*", "src/engine/**/*"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
